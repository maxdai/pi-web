{
  "name": "pi-sdk-web",
  "version": "0.6.1",
  "description": "Browser Web access for Pi (AI coding agent) via the Pi SDK - standalone module, zero modification to Pi itself",
  "type": "module",
  "bin": {
    "pi-web": "./dist/cli.js",
    "pii": "./dist/pi-bin/pii-cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-assets.mjs",
    "dev": "tsx src/cli.ts",
    "verify": "tsx src/verify-sdk.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxdai/pi-web.git"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "browser",
    "web-ui",
    "agent",
    "coding-agent"
  ],
  "author": "maxdai"
}
