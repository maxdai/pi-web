{
  "name": "@maxdai/pi-web",
  "version": "1.2.6",
  "description": "Browser Web access for Pi (AI coding agent) via the native engine (pi --mode rpc + injected bridge extension) - zero modification to Pi itself",
  "type": "module",
  "bin": {
    "pi-web": "./dist/native/cli.mjs",
    "pi-web-native": "./dist/native/server.mjs",
    "pii": "./dist/native/pii-cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxdai/pi-web.git"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "browser",
    "web-ui",
    "agent",
    "coding-agent"
  ],
  "author": "maxdai"
}
